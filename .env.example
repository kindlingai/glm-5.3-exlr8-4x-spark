# GLM-5.3 on four DGX Sparks at TP=4. Copy to .env next to compose.yaml on every box: the same file on all four.
# Compose passes each line into the container, where gr8's launcher reads it as an option
# (`docker compose exec gr8 /opt/gr8/gr8 knobs` lists every option and its default).
#
# Set PEERS. The other active lines are the settings the README's numbers were measured with. The launcher owns every
# default (KV format, context, drafting): this file adds only the model, the boxes, the caches and the KV store.

# --- the model -------------------------------------------------------------------------------------------------------
GR8_MODEL=glm53
# The release, pinned to the Hugging Face commit the README's numbers were measured with. The model cache is keyed
# by commit, so a new commit on the repo changes nothing here until this line moves.
MODEL=https://huggingface.co/kindlingai/glm-5.3-exlr8-k2-k3-k4@a36ae4680871ffa6412061d5daf66c4d4ad5802c
# TP=4 only: the DFlash2 drafter. Its licence (CC BY-NC-ND) forbids sharing a converted copy, so each box converts
# its own at the first boot. Remove the line to draft with MTP only. Pinned to the measured commit, as MODEL is.
DRAFTER=https://huggingface.co/incoai/GLM-5.3-DFlash2@425aa615ce320caac34400208b30808c8f14f76c
# The exlr8 width manifest. Unset: home at TP=4, 5 and 6, bit225 at TP=3. `gr8 knobs VARIANT` lists the others.
#VARIANT=bit225
# KV format. Unset at TP=4: int4 (513,536-token pool). fp8 gives the earlier default (485,376-token pool).
#KV_FORMAT=fp8
# Sent only to Hugging Face, for a gated or private repo.
#HF_TOKEN=

# --- the boxes -------------------------------------------------------------------------------------------------------
# The LAN address of every box, in rank order, the same line on every box. The first is the head (OpenAI API on
# port 8100). TP is the number of addresses: three, five or six addresses run TP=3, 5 or 6 (README, "Other box counts").
PEERS=192.0.2.1,192.0.2.2,192.0.2.3,192.0.2.4
# No switch: the boxes are cabled in a ring, in PEERS order (TP=3 or 4 only).
#SHAPE=ring
# Per box: this box's LAN address, when PEERS holds more than one address of this box.
#NODE_IP=

# --- the container (read by compose, not by the launcher) ------------------------------------------------------------
# A host directory for this box's part of the model (about 90 GB at TP=4) and the caches below, owned by uid 1000.
# Unset, a named volume.
#GR8_CACHE=/srv/gr8/cache
# A host directory for logs and state, owned by uid 1000.
#GR8_HOME=/srv/gr8/home

# --- fast restarts ---------------------------------------------------------------------------------------------------
# GR8_GEN_CACHE: the loader keeps the tensors it computes at load and reads them back at the next boot.
# GR8_QUIT_FAST=1: an orderly stop ends right after the quit barrier.
# GR8_LOAD_COMPACT + GR8_LOAD_MERGE_KB=1: the loader reads dense per-rank copies of its expert ranges, once
# `docker compose run --rm gr8 prepare` has written them (about 70 GiB a box beside the release). Until then the
# loader reads the release as before. TP=4 only: remove the two compact settings for another box count.
EXTRA_ENV="GR8_GEN_CACHE=/var/lib/gr8/cache/gen-cache GR8_QUIT_FAST=1 GR8_LOAD_COMPACT=/var/lib/gr8/cache/compact-tp4 GR8_LOAD_MERGE_KB=1"

# --- the KV store ----------------------------------------------------------------------------------------------------
# A persistent SSD KV store: at an orderly stop the engine stores the chats it still holds, and the next boot reads
# them back. GR8_STOP_GRACE gives docker's stop the time that needs.
KV_STORE=ssd:/var/lib/gr8/cache/kv,size=200G,persist=on,keep=sessions
GR8_STOP_GRACE=150s
